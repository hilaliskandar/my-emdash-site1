---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const categoryResult = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

// Some imported EmDash posts are published but not returned by the category
// filter. Keep the normal query, and recover the known Radar editorial series
// from their stable slugs if the category archive unexpectedly comes back empty.
const editorialPrefix =
	term.slug === "radar-normativo-urbano" ? "radar-normativo-" :
	term.slug === "radar-imobiliario-metropolitano" ? "radar-imobiliario-" :
	null;
let posts = categoryResult.entries;
let cacheHint = categoryResult.cacheHint;
let nextCursor = categoryResult.nextCursor;
if (posts.length === 0 && editorialPrefix) {
	const recovered = await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 100,
		cursor,
	});
	posts = recovered.entries.filter((entry) => entry.id.startsWith(editorialPrefix));
	cacheHint = recovered.cacheHint;
	nextCursor = recovered.nextCursor;
}

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={term.label} description={`Publicações e análises do ${term.label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">EDITORIA</span>
			<h1 class="archive-title">{term.label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">As edições desta editoria estão sendo preparadas.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							edit={post.edit}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Paginação">
			{cursor && <a href={`/category/${term.slug}`}>Primeira página</a>}
			{
				nextCursor && (
					<a
						href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
					>
						Next page
					</a>
				)
			}
		</nav>
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
