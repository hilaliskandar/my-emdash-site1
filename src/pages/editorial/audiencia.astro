---
export const prerender = false;

type AudienceRow = {
  slug: string; title: string; published_at: string | null; editoria: string;
  estimated: number; reais: number; total_experimental: number;
};
const headers = Astro.response.headers;
headers.set("Cache-Control", "private, no-store, max-age=0");
headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
headers.set("Referrer-Policy", "no-referrer");
const db = (Astro.locals as typeof Astro.locals & { runtime: { env: { DB: D1Database } } }).runtime.env.DB;
const categorias = ["todas", "normativo", "imobiliario", "contratacoes", "puxadinho", "outros"] as const;
const selected = categorias.includes(Astro.url.searchParams.get("editoria") as typeof categorias[number])
  ? Astro.url.searchParams.get("editoria")! : "todas";
const periodo = Astro.url.searchParams.get("periodo");
const dias = periodo === "7" ? 7 : periodo === "30" ? 30 : periodo === "90" ? 90 : 0;
const dateFrom = dias ? new Date(Date.now() - dias * 86400000).toISOString().slice(0, 10) : "";
let rows: AudienceRow[] = [];
let error = false;
try {
  const result = await db.prepare(`
    WITH reais AS (
      SELECT entry_id, SUM(views) AS views
      FROM radar_article_views
      WHERE (?1 = '' OR day >= ?1)
      GROUP BY entry_id
    )
    SELECT p.slug, p.title, p.published_at,
      CASE
        WHEN p.slug LIKE 'radar-normativo-%' THEN 'normativo'
        WHEN p.slug LIKE 'radar-imobiliario-%' THEN 'imobiliario'
        WHEN p.slug LIKE 'radar-contratacoes-%' THEN 'contratacoes'
        WHEN p.slug LIKE 'puxadinho-%' THEN 'puxadinho'
        ELSE 'outros'
      END AS editoria,
      COALESCE(e.estimated_views,0) AS estimated,
      COALESCE(r.views,0) AS reais,
      COALESCE(e.estimated_views,0) + COALESCE(r.views,0) AS total_experimental
    FROM ec_posts p
    LEFT JOIN radar_article_view_estimates e ON e.entry_id=p.id
    LEFT JOIN reais r ON r.entry_id=p.id
    WHERE p.status='published' AND p.deleted_at IS NULL
    ORDER BY COALESCE(r.views,0) DESC, p.published_at DESC
  `).bind(dateFrom).all<AudienceRow>();
  rows = result.results;
} catch {
  error = true;
  Astro.response.status = 503;
}
const filtered = selected === "todas" ? rows : rows.filter((row) => row.editoria === selected);
const realTotal = filtered.reduce((sum,row)=>sum+row.reais,0);
const estimateTotal = filtered.reduce((sum,row)=>sum+row.estimated,0);
const formatter = new Intl.NumberFormat("pt-BR");
const categoryName: Record<string,string> = {
  todas: "Todas",normativo:"Radar Normativo",imobiliario:"Radar Imobiliário",
  contratacoes:"Radar Contratações",puxadinho:"Puxadinho",outros:"Outras publicações"
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Audiência editorial privada · Radar Regulatório</title>
    <style>
      :root{font-family:system-ui,-apple-system,sans-serif;color:#1e293b;background:#f8fafc}
      body{margin:0}main{max-width:1200px;margin:auto;padding:2rem 1.2rem}
      h1{font-size:1.75rem;margin:0 0 .5rem}p{line-height:1.55}
      .muted{color:#64748b}.notice{background:#fff7ed;border-left:4px solid #c2410c;padding:.8rem 1rem}
      .metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin:1.5rem 0}
      .metric{background:white;border:1px solid #e2e8f0;border-radius:10px;padding:1rem}
      .metric strong{font-size:1.8rem;display:block;margin:.4rem 0}
      form{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;margin:1.5rem 0}
      label{display:grid;gap:.3rem;font-weight:600}select,button{font:inherit;padding:.55rem;border:1px solid #94a3b8;border-radius:6px;background:white}
      button{background:#0f172a;color:white;cursor:pointer;padding:.6rem 1rem}
      .table-scroll{overflow-x:auto;border:1px solid #e2e8f0;border-radius:8px;background:white}
      table{border-collapse:collapse;width:100%;font-size:.92rem}
      th,td{border-bottom:1px solid #e2e8f0;padding:.8rem;text-align:left}
      th{background:#f1f5f9}td.number,th.number{text-align:right;font-variant-numeric:tabular-nums}
      a{color:#1d4ed8}caption{text-align:left;padding:.75rem;font-weight:600}
    </style>
  </head>
  <body>
    <main>
      <p><a href="/">← Portal Radar Regulatório</a></p>
      <h1>Painel de audiência editorial</h1>
      <p class="muted">Uso interno · Consulta ao Cloudflare D1 · Indicadores separados por origem</p>
      <p class="notice"><strong>Atenção:</strong> os valores estimados são dados sintéticos, gerados para simulação e não demonstram audiência histórica. Somente a coluna “Visualizações reais” representa registros efetivamente coletados desde a implantação do contador.</p>
      {error ? <p role="alert">Não foi possível consultar as métricas agora. Nenhum valor foi alterado.</p> : (
        <>
          <form method="get">
            <label>Editoria
              <select name="editoria">
                {categorias.map((c) => <option value={c} selected={selected===c}>{categoryName[c]}</option>)}
              </select>
            </label>
            <label>Período das visualizações reais
              <select name="periodo">
                <option value="0" selected={dias===0}>Todo o período registrado</option>
                <option value="7" selected={dias===7}>Últimos 7 dias</option>
                <option value="30" selected={dias===30}>Últimos 30 dias</option>
                <option value="90" selected={dias===90}>Últimos 90 dias</option>
              </select>
            </label>
            <button type="submit">Aplicar filtros</button>
          </form>
          <div class="metrics">
            <div class="metric"><span>Artigos publicados</span><strong>{formatter.format(filtered.length)}</strong></div>
            <div class="metric"><span>Visualizações reais no período</span><strong>{formatter.format(realTotal)}</strong></div>
            <div class="metric"><span>Visualizações sintéticas iniciais</span><strong>{formatter.format(estimateTotal)}</strong></div>
          </div>
          <p class="muted">O filtro de período afeta apenas as visualizações reais. As estimativas iniciais são valores fixos por artigo, não séries históricas. O total experimental não representa audiência comprovada.</p>
          <div class="table-scroll">
            <table>
              <caption>Publicações e respectivas métricas</caption>
              <thead><tr><th>Artigo</th><th>Editoria</th><th>Publicação</th><th class="number">Reais</th><th class="number">Simuladas</th><th class="number">Total experimental</th></tr></thead>
              <tbody>
                {filtered.map((row) => <tr>
                  <td><a href={`/posts/${encodeURIComponent(row.slug)}`}>{row.title}</a></td>
                  <td>{categoryName[row.editoria]}</td>
                  <td>{row.published_at?.slice(0,10).split("-").reverse().join("/") ?? "—"}</td>
                  <td class="number">{formatter.format(row.reais)}</td>
                  <td class="number">{formatter.format(row.estimated)}</td>
                  <td class="number">{formatter.format(row.total_experimental)}</td>
                </tr>)}
              </tbody>
            </table>
          </div>
          <p class="muted">Fonte: tabelas radar_article_views e radar_article_view_estimates do Cloudflare D1. O acesso a esta página depende da proteção do Cloudflare Access; ela não deve receber exceção pública.</p>
        </>
      )}
    </main>
  </body>
</html>
