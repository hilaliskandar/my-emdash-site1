---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

// EmDash's taxonomy "where" filter currently returns no posts for imported
// tag assignments. Use the same bounded collection and batched tag query that
// powers the editorial taxonomy; avoid N+1 reads.
const { entries: recentPosts, cacheHint } = await getEmDashCollection("posts", {
  locale: "pt-BR",
  status: "published",
  orderBy: { published_at: "desc" },
  limit: 100,
});
const tagsByEntry = await getTermsForEntries(
  "posts",
  recentPosts.map((post) => post.data.id),
  "tag",
);
const matchingPosts = recentPosts
  .filter((post) => (tagsByEntry.get(post.data.id) ?? []).some((tag) => tag.slug === term.slug));
const pageNumber = Math.max(1, Math.min(1000, Number.parseInt(Astro.url.searchParams.get("pagina") || "1", 10) || 1));
const pageSize = 20;
const totalPages = Math.ceil(matchingPosts.length / pageSize);
const posts = matchingPosts.slice((pageNumber - 1) * pageSize, pageNumber * pageSize);
if (Astro.cache?.enabled) {
  Astro.cache.set(termsResult.cacheHint);
  Astro.cache.set(cacheHint);
}
const filteredPosts = posts.map((post) => ({
  post,
  tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base
	title={`Publicações sobre ${term.label}`}
	description={`Publicações do Radar Regulatório relacionadas a ${term.label}.`}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">ASSUNTO</span>
			<h1 class="archive-title">{term.label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">Nenhuma publicação vinculada a esta etiqueta.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							edit={post.edit}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Paginação">
      {pageNumber > 1 && <a href={`/tag/${encodeURIComponent(term.slug)}?pagina=${pageNumber - 1}`}>Página anterior</a>}
      {pageNumber < totalPages && <a href={`/tag/${encodeURIComponent(term.slug)}?pagina=${pageNumber + 1}`}>Próxima página</a>}
    </nav>
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
